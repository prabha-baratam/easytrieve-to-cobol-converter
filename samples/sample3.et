FILE CUSTOMER_RECORDS
  CUST_ID 6 N
  CUST_NAME 40 A
  PHONE 12 A
  EMAIL 50 A
  CREDIT_LIMIT 9 N
END-FILE

READ CUSTOMER_RECORDS
  IF CREDIT_LIMIT >= 10000
    DISPLAY CUST_ID CUST_NAME CREDIT_LIMIT "PLATINUM"
  ELSE
    IF CREDIT_LIMIT >= 5000
      DISPLAY CUST_ID CUST_NAME CREDIT_LIMIT "GOLD"
    ELSE
      DISPLAY CUST_ID CUST_NAME CREDIT_LIMIT "STANDARD"
    END-IF
  END-IF
END-PROGRAM
